[Unit]
Description=Wenet BLE sensor client
Documentation=https://github.com/ke5gdb/wenet_payload_ble_bridge
After=bluetooth.service network.target
Wants=bluetooth.service

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=bluetooth
WorkingDirectory=/home/pi/ble_bridge
ExecStart=/usr/bin/python3 /home/pi/ble_bridge/wenet_ble_client.py
# Unbuffered so log lines reach the journal as they happen
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
# SIGTERM is handled so BLE links get disconnected on the way out -- a link left open
# stops the sensor advertising, and the next run cannot find it. Allow time for that.
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wenet_ble

[Install]
WantedBy=multi-user.target
